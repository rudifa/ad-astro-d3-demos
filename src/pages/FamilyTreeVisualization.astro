---
import ShoelaceLayout from '../layouts/ShoelaceLayout.astro';
import { FamilyTreeVisualization } from '../components/FamilyTreeVisualization.js';

const familyData1 = [
  { id: 'Grandpa1', parentIds: [] },
  { id: 'Grandma1', parentIds: [] },
  { id: 'Grandpa2', parentIds: [] },
  { id: 'Grandma2', parentIds: [] },
  { id: 'Parent1', parentIds: ['Grandpa1', 'Grandma1'] },
  { id: 'Parent2', parentIds: ['Grandpa2', 'Grandma2'] },
  { id: 'Parent3', parentIds: ['Grandpa1', 'Grandma1'] },
  { id: 'Child1', parentIds: ['Parent1', 'Parent2'] },
  { id: 'Child2', parentIds: ['Parent1', 'Parent2'] },
  { id: 'Child3', parentIds: ['Parent3'] },
];

const familyData2 = [
  { id: 'Grandpa1', parentIds: [] },
  { id: 'Grandma1', parentIds: [] },
  { id: 'Grandpa2', parentIds: [] },
  { id: 'Grandma2', parentIds: [] },
  { id: 'Parent1', parentIds: ['Grandpa1', 'Grandma1'] },
  { id: 'Parent2', parentIds: ['Grandpa2', 'Grandma2'] },
  { id: 'Parent3', parentIds: ['Grandpa1', 'Grandma1'] },
  { id: 'Parent4', parentIds: ['Grandpa2', 'Grandma2'] },
  { id: 'Child1', parentIds: ['Parent1', 'Parent2'] },
  { id: 'Child2', parentIds: ['Parent1', 'Parent2'] },
  { id: 'Child3', parentIds: ['Parent3'] },
  { id: 'Child4', parentIds: ['Parent3', 'Parent4'] },
  { id: 'Child5', parentIds: ['Parent4'] },
  { id: 'Grandchild1', parentIds: ['Child1'] },
  { id: 'Grandchild2', parentIds: ['Child2', 'Child3'] },
  { id: 'Grandchild3', parentIds: ['Child4'] },
  { id: 'Grandchild4', parentIds: ['Child5'] },
];
---

<ShoelaceLayout title='D3-dag Family Tree Visualization'>
  <div class='container mx-auto p-8'>
    <h1 class='text-4xl font-bold mb-6'>
      Family Tree Visualizations with D3-dag
    </h1>

    <section class='mb-12'>
      <h2 class='text-2xl font-semibold mb-4'>Family Tree</h2>
      <p class='mb-4'>
        This visualization uses the family tree data built into the page.
      </p>

      <sl-select
        label='Select Family Data'
        id='familyDataSelect'
        class='custom-select'
      >
        <sl-option value='familyData1' selected>Family Data 1</sl-option>
        <sl-option value='familyData2'>Family Data 2</sl-option>
      </sl-select>

      <FamilyTreeVisualization
        client:load
        family-data={JSON.stringify(familyData1)}
        class='family-tree-viz border-2 border-gray-300 rounded-lg shadow-md p-4'
        id='family-tree-svg'
      />
    </section>
  </div>
</ShoelaceLayout>

<script define:vars={{ familyData1, familyData2 }}>
  document.addEventListener('DOMContentLoaded', () => {
    const select = document.getElementById('familyDataSelect');
    const familyTreeViz = document.getElementById('family-tree-svg');

    // Set initial value
    select.value = 'familyData1';

    select.addEventListener('sl-change', (event) => {
      const selectedData =
        event.target.value === 'familyData1' ? familyData1 : familyData2;
      familyTreeViz.setAttribute('family-data', JSON.stringify(selectedData));
    });
  });
</script>

<style>
  .family-tree-viz {
    border: 2px solid #e5e7eb;
    border-radius: 1.5rem;
    box-shadow:
      0 4px 6px -1px rgba(0, 0, 0, 0.1),
      0 2px 4px -1px rgba(0, 0, 0, 0.06);
    padding: 1rem;
  }

  .container {
    margin-left: 2rem;
    background-color: #f7fafc;
    min-height: 100vh; /* This ensures the container takes at least the full viewport height */
    padding-bottom: 2rem; /* Add some padding at the bottom for better appearance */
  }

  .custom-select::part(form-control) {
    width: 150px;
    margin-bottom: 1rem;
    margin-left: 2rem;
  }

  .custom-select::part(base) {
    border-color: #4a5568;
    border-radius: 0.375rem;
    background-color: #f7fafc;
  }

  .custom-select::part(control) {
    background-color: #edf2f7;
  }

  .custom-select::part(label) {
    color: #2d3748;
    font-weight: bold;
  }
</style>
